    {
      "id": 52,
      "type": "heatmap",
      "title": "Top-score distribution",
      "description": "Score of the best-ranked hit per query. rd_corpus and code_exemplars are RRF-fused, so their scores are rank-based and small by nature; run_memory is a raw cosine score against a 0.82 floor. The two are on one axis here \u2014 read them as separate populations.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (le) (increase(pluton_retrieval_top_score_bucket[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64,
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false
        },
        "yAxis": {
          "unit": "short",
          "axisPlacement": "left"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "rowsFrame": {
          "layout": "auto"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 53,
      "type": "heatmap",
      "title": "Hits-per-query distribution",
