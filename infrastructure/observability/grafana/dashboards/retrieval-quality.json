{
  "uid": "pluton-retrieval-quality",
  "title": "Retrieval Quality",
  "description": "Hybrid search latency and hit quality per collection (ARCHITECTURE.md \u00a77.3), plus the episodic-memory hit rate.",
  "tags": [
    "pluton"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 43,
      "type": "row",
      "title": "Episodic memory",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 44,
      "type": "gauge",
      "title": "Run-memory hit rate",
      "description": "Fraction of Debugger lookups that found a prior successful fix for the same error fingerprint. Necessarily near zero on a fresh install \u2014 the collection only fills as runs succeed \u2014 so read the *trend*, not the value. The 0.82 cosine floor (\u00a77.3.3) is what keeps a hit meaningful.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 0.2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(pluton_run_memory_hits_total{outcome=\"hit\"}[$__range])) / clamp_min(sum(increase(pluton_run_memory_hits_total[$__range])), 1)",
          "legendFormat": "hit rate",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 45,
      "type": "timeseries",
      "title": "Run-memory lookups",
      "description": "Hits and misses over time. Only SUCCEEDED runs write to this collection, so a platform that is failing everything cannot learn from itself.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 18,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": null,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 50,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(pluton_run_memory_hits_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 46,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 47,
      "type": "timeseries",
      "title": "Search latency by collection",
      "description": "Timed from before the query embedding, not from the Qdrant call \u2014 on this hardware the embedding round trip is usually the larger half, and a panel that excluded it would stay flat while retrieval got slower.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, collection) (rate(pluton_retrieval_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{collection}} p95",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, collection) (rate(pluton_retrieval_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{collection}} p50",
          "range": true,
          "instant": false,
          "refId": "B",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 48,
      "type": "stat",
      "title": "Searches / min",
      "description": "All collections. The Researcher issues several per round.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "text": {
          "valueSize": 32
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(pluton_retrieval_latency_seconds_count[$__rate_interval])) * 60",
          "legendFormat": "searches",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 49,
      "type": "stat",
      "title": "Empty-result rate",
      "description": "Queries whose best hit scored 0 \u2014 nothing cleared the score floor. A high value means the corpus does not cover what the agents are asking about, which is an ingestion problem rather than a retrieval one.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 9,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "text": {
          "valueSize": 32
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(pluton_retrieval_top_score_bucket{le=\"0.0\"}[$__range])) / clamp_min(sum(increase(pluton_retrieval_hits_count[$__range])), 1)",
          "legendFormat": "empty",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 50,
      "type": "timeseries",
      "title": "Mean hits per query",
      "description": "Against the \u00a77.3.4 limits: 8 for rd_corpus, 4 for code_exemplars, 3 for run_memory. Sitting at the limit means the floor is not binding; sitting well below it means it is.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (collection) (rate(pluton_retrieval_hits_sum[$__rate_interval])) / clamp_min(sum by (collection) (rate(pluton_retrieval_hits_count[$__rate_interval])), 0.0001)",
          "legendFormat": "{{collection}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 51,
      "type": "row",
      "title": "Hit quality",
      "collapsed": false,
      "gridPos": {
        "x": 0,
