        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (stage) (rate(pluton_structured_output_attempts_count[$__rate_interval]))",
          "legendFormat": "{{stage}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ]
