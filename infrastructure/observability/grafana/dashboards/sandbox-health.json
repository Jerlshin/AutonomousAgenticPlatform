      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, profile) (rate(pluton_sandbox_max_rss_bytes_bucket[$__rate_interval])))",
          "legendFormat": "{{profile}} p95",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, profile) (rate(pluton_sandbox_max_rss_bytes_bucket[$__rate_interval])))",
          "legendFormat": "{{profile}} p50",
          "range": true,
          "instant": false,
          "refId": "B",
          "format": "time_series"
        }
      ]
