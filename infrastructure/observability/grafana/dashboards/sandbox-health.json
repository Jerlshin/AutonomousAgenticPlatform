    {
      "id": 36,
      "type": "timeseries",
      "title": "Executions by classification",
      "description": "The \u00a710.9 vocabulary. TIMEOUT and OOM take precedence over the exit code, and OOM takes precedence over TIMEOUT \u2014 a container killed for memory that also ran long is a memory story.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 5,
        "w": 19,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 60,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (classification) (increase(pluton_sandbox_executions_total[$__rate_interval]))",
          "legendFormat": "{{classification}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 37,
