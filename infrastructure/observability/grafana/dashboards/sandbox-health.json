{
  "uid": "pluton-sandbox-health",
  "title": "Sandbox Health",
  "description": "Execution outcomes and resource pressure for the container boundary described in ARCHITECTURE.md \u00a710. A regression here is the platform's highest-severity failure.",
  "tags": [
    "pluton"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 30,
      "type": "row",
      "title": "Outcomes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 31,
      "type": "gauge",
      "title": "Clean-execution rate",
      "description": "Executions that exited 0. The rest are the debug loop's input \u2014 a low value is not necessarily bad, but a *falling* one means the Coder is regressing.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.6
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(pluton_sandbox_executions_total{classification=\"CLEAN\"}[$__range])) / clamp_min(sum(increase(pluton_sandbox_executions_total[$__range])), 1)",
          "legendFormat": "clean",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Timeouts / h",
      "description": "Killed at the wall clock: SANDBOX_EXEC_TIMEOUT_S / SANDBOX_TRAIN_TIMEOUT_S. Reported as exit 137.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "text": {
          "valueSize": 32
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(pluton_sandbox_timeouts_total[1h]))",
          "legendFormat": "timeouts",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 33,
      "type": "stat",
      "title": "OOM kills / h",
      "description": "Killed by the cgroup limit. `--memory-swap` equals `--memory` (\u00a710.4), so an allocation loop is killed rather than swapping the host to death.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "text": {
          "valueSize": 32
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(pluton_sandbox_oom_total[1h]))",
          "legendFormat": "ooms",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
