        "h": 1
      },
      "panels": []
    },
    {
      "id": 38,
      "type": "timeseries",
      "title": "Execution duration",
      "description": "Includes container create and teardown, which is a second or two of the floor on the `exec` profile.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, profile) (rate(pluton_sandbox_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{profile}} p50",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pluton-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, profile) (rate(pluton_sandbox_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{profile}} p95",
          "range": true,
          "instant": false,
          "refId": "B",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 39,
      "type": "timeseries",
      "title": "Peak container RSS",
      "description": "Sampled every 2 s while the container runs, so a spike shorter than the sampling interval can be missed \u2014 an OOM with a low peak here is that case, not a contradiction. Compare against SANDBOX_EXEC_MEMORY / SANDBOX_TRAIN_MEMORY.",
      "datasource": {
        "type": "prometheus",
        "uid": "pluton-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
