# docs/FRONTEND.md §12.3.

# Where the browser reaches the API. Absolute, because the WebSocket in ARCHITECTURE.md §9
# cannot go through a Next.js rewrite (see next.config.ts).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# The bearer token from the repository-root .env, when one is configured. Leave empty on a
# loopback development box, where the API requires no token.
#
# NEXT_PUBLIC_ is a browser-visible prefix: this value ships to the client, which is
# acceptable only because it is the same single shared token the platform already assumes
# anyone who can reach the API possesses (ARCHITECTURE.md §13.2). Do not put a real
# multi-user credential here.
NEXT_PUBLIC_API_TOKEN=

# Server-only. Route Handlers (the artifact proxy, the Shiki highlighter) attach this
# instead of the browser-visible token, so a plot preview does not put a credential in a
# query string. It MUST NOT carry the NEXT_PUBLIC_ prefix — that prefix is what ships a
# value to the client, and this one must not ship.
PLATFORM_API_TOKEN=

# For composing MLflow deep links when a payload carries no `ui_url` (MLOPS.md §4.1).
NEXT_PUBLIC_MLFLOW_BASE=http://localhost:5001

# `1` enables the debug drawer's verbose logging (§9.5). Off by default: `console.log` in
# the console pane's render path is a performance bug, not a diagnostic.
NEXT_PUBLIC_DEBUG_STREAM=0
