# ==============================================================================
#  Pluton R&D Engine — environment template
#
#  GENERATED FILE — do not edit by hand.
#  Regenerate with `make gen-env-example` after changing backend/app/core/config.py.
#
#  Copy to .env with `make init-secrets`, which also fills the secret values.
#  Every variable below is a field on `Settings`; anything not listed here is not
#  read by the application. Reference: docs/ARCHITECTURE.md §14.
#
#  Values are the host-development defaults — `make migrate` and `make dev` run
#  natively on the host. Lines marked "in-network" show the value used by services
#  running inside the compose network, which docker-compose.yml injects itself.
# ==============================================================================

# ------------------------------------------------------------------
#  Core
# ------------------------------------------------------------------
# Human-readable platform name, shown in the OpenAPI title.
PROJECT_NAME=Autonomous Multi-Agent AI Platform

# development | staging | production | testing.
ENVIRONMENT=development

# Root log level.
LOG_LEVEL=INFO

# json for shipping, console for local reading.
LOG_FORMAT=json

# Mount prefix for the v1 API.
API_V1_STR=/api/v1

# Bind address. Loopback by default; LAN binding requires
# PLATFORM_ALLOW_LAN=1.
# in-network (docker compose): 0.0.0.0
HOST=127.0.0.1

# API port.
PORT=8000

# Bearer token for every non-health endpoint. Required outside development.
# secret — `make init-secrets` replaces this value
PLATFORM_API_TOKEN=

# Set to 1 to permit binding a non-loopback HOST.
PLATFORM_ALLOW_LAN=false

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# Signing key for session and token material.
# secret — `make init-secrets` replaces this value
SECRET_KEY=dev_secret_key_change_in_production

# ------------------------------------------------------------------
#  Datastores
# ------------------------------------------------------------------
# Postgres host.
# in-network (docker compose): postgres
POSTGRES_SERVER=localhost

# Postgres port.
POSTGRES_PORT=5432

# Postgres role.
POSTGRES_USER=postgres

# Postgres password. Must match infrastructure/docker-compose.yml.
# secret — `make init-secrets` replaces this value
POSTGRES_PASSWORD=postgres_password_dev

# Application database.
POSTGRES_DB=agent_platform

# MLflow backend store database — separate logical DB, same server.
MLFLOW_POSTGRES_DB=mlflow

# Full DSN. If set it MUST use the postgresql+asyncpg:// scheme; anything else
# is rejected at startup. Leave unset to compose it from POSTGRES_*.
DATABASE_URL=

# Operational Redis database (queue, streams, locks).
# in-network (docker compose): redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Cache-only Redis database — safe to FLUSHDB.
# in-network (docker compose): redis://redis:6379/1
REDIS_CACHE_URL=redis://localhost:6379/1

# Qdrant REST endpoint.
# in-network (docker compose): http://qdrant:6333
QDRANT_URL=http://localhost:6333

# Use gRPC (port 6334) for bulk ingestion.
QDRANT_PREFER_GRPC=true

# Artifacts larger than this go to the volume or MLflow instead of a DB
# column.
ARTIFACT_INLINE_MAX_BYTES=262144

# ------------------------------------------------------------------
#  Models
# ------------------------------------------------------------------
# Ollama runs natively on the host (ADR-012). host.docker.internal does not
# resolve from a host process, so the host form is the default.
# in-network (docker compose): http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# small swaps every unset per-role model for the 3B ladder (~6 GB total).
PLUTON_MODEL_TIER=standard

# Planner role.
PLANNER_MODEL=qwen2.5:14b-instruct

# Researcher role.
RESEARCHER_MODEL=llama3.1:8b

# Coder role.
CODER_MODEL=qwen2.5-coder:7b

# Debugger role.
DEBUGGER_MODEL=qwen2.5-coder:7b

# Evaluator role.
EVALUATOR_MODEL=llama3.1:8b

# Reporter role.
REPORTER_MODEL=llama3.1:8b

# Fallback for any role without its own model.
DEFAULT_MODEL=llama3.1:8b

# Embedding model.
EMBEDDING_MODEL=nomic-embed-text

# Vector width; must match the collection in Qdrant.
EMBEDDING_DIM=768

# How long Ollama keeps a model resident after a call.
OLLAMA_KEEP_ALIVE=30m

# Per-request timeout for Ollama calls.
OLLAMA_REQUEST_TIMEOUT_S=300

# ------------------------------------------------------------------
#  Sandbox
# ------------------------------------------------------------------
# Master switch for sandboxed code execution.
SANDBOX_ENABLED=true

# Use the Docker driver. False selects the in-process stub (development only).
USE_DOCKER_SANDBOX=true

# runsc selects gVisor where it is installed.
SANDBOX_RUNTIME=runc

# Profile used when a node does not name one.
SANDBOX_DEFAULT_PROFILE=exec

# Image for the exec profile.
SANDBOX_IMAGE=pluton-sandbox-exec:latest

# Image for the train profile.
SANDBOX_TRAIN_IMAGE=pluton-sandbox-train:latest

# Wall clock for exec runs.
SANDBOX_EXEC_TIMEOUT_S=60

# Wall clock for train runs.
SANDBOX_TRAIN_TIMEOUT_S=900

# Memory cap, exec profile.
SANDBOX_EXEC_MEMORY=2g

# Memory cap, train profile.
SANDBOX_TRAIN_MEMORY=6g

# Captured stdout/stderr ceiling per execution.
SANDBOX_MAX_OUTPUT_BYTES=2097152

# Docker endpoint the sandbox driver talks to.
DOCKER_HOST=unix:///var/run/docker.sock

# Mount point of the pluton_runs volume.
RUNS_ROOT=/runs

# Read-only dataset registry volume.
DATASETS_VOLUME=pluton_datasets

# Host-side path to the dataset registry, read by the Planner to bind steps to
# concrete datasets. Sandboxes always see it at /datasets via the volume
# above.
# in-network (docker compose): /datasets
DATASETS_ROOT=./datasets

# ------------------------------------------------------------------
#  Graph budgets
# ------------------------------------------------------------------
# Debug loop ceiling.
MAX_DEBUG_ITERATIONS=4

# Replan ceiling per run.
MAX_REPLANS=2

# Total node visits per run.
MAX_NODE_VISITS=60

# Sandbox executions per run.
MAX_SANDBOX_EXECUTIONS=12

# Retries for a single failing agent call.
MAX_AGENT_RETRIES=2

# Hard run deadline.
RUN_WALLCLOCK_SECONDS=1800

# Token budget per run.
RUN_MAX_TOKENS=250000

# How long a human-approval gate waits.
HITL_GATE_TIMEOUT_S=1800

# ------------------------------------------------------------------
#  Worker and MLflow
# ------------------------------------------------------------------
# Concurrent arq jobs.
WORKER_MAX_JOBS=2

# arq job timeout.
WORKER_JOB_TIMEOUT_S=2400

# Worker /healthz port.
WORKER_HEALTH_PORT=8001

# Redis run-ownership lock TTL.
RUN_LOCK_TTL_S=1800

# Where the MLflow client logs to. Host port is 5001 because macOS AirPlay
# claims 5000 (ADR-015); in-network callers use http://mlflow:5000.
# in-network (docker compose): http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5001

# Browser-reachable MLflow URL, used only to build clickable links.
MLFLOW_PUBLIC_URL=http://localhost:5001

# Prefix for created experiments.
MLFLOW_EXPERIMENT_PREFIX=pluton

# Register models produced by a run.
MLFLOW_REGISTRY_ENABLED=true

# ------------------------------------------------------------------
#  Observability profile (not read by the backend)
# ------------------------------------------------------------------
# Grafana admin password, used only by `make up PROFILE=observability`.
# secret — `make init-secrets` replaces this value
GRAFANA_ADMIN_PASSWORD=
